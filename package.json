{
  "name": "citymind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "test": "npm run test:unit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:browser": "playwright test tests/browser/worker.smoke.spec.ts",
    "test:perf": "CITYMIND_RUN_PERF=1 playwright test tests/browser/tps.perf.spec.ts",
    "verify": "npm run typecheck && npm run test:unit && npm run build && npm run test:browser"
  },
  "dependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@playwright/test": "^1.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vitest": "^2.0.0"
  }
}
